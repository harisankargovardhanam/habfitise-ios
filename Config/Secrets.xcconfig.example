// IMPORTANT: xcconfig treats // as a comment. Use https:/$()/ for Supabase URLs.
SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_ANON_KEY = your-anon-key

// RevenueCat → Project Settings → Apps → VAYA (iOS) → Public SDK key (starts with appl_)
// Do NOT use the secret API key here.
REVENUECAT_API_KEY = appl_your_ios_public_sdk_key
